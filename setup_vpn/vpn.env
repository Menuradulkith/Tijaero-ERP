# =============================================================================
# TijaeroERP VPN Configuration
# Edit this file to match your VPS. All scripts and docker-compose read from here.
# =============================================================================

# Public IP of the VPS (used in client .ovpn files and firewall rules)
VPS_PUBLIC_IP=51.79.226.133

# VPN tunnel settings
VPN_PORT=1194
VPN_PROTO=udp

# VPN subnet – server gets the first IP (.1), clients get .2 onward
VPN_SUBNET=10.8.0.0
VPN_MASK=255.255.255.0
VPN_GATEWAY_IP=10.8.0.1   # IP of the VPS inside the VPN tunnel
