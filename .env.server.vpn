# Global Environment Variables for ERP System - SERVER/PRODUCTION
# Server IP: 51.79.226.133

# Project Configuration
PROJECT_NAME=ERP System
VERSION=1.0.0
API_V1_STR=/api/v1
# If GATEWAY_IP is changed, it needs to be built the frontend
GATEWAY_IP=10.8.0.1

# Database Configuration
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_IN_PRODUCTION
POSTGRES_DB=erp_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Backend Configuration
BACKEND_PORT=8000
SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_MIN_32_CHARS_FOR_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS=["http://10.8.0.1:80","http://10.8.0.1:443","https://yourdomain.com"]

# Frontend Configuration
FRONTEND_PORT=3000

# Adminer Configuration
ADMINER_PORT=8080
ADMINER_DEFAULT_SERVER=postgres
ADMINER_DESIGN=nette

# pgAdmin Configuration
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
