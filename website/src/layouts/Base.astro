---
// Fonts are self-hosted (no request to Google: better privacy and a strict CSP).
import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { t, pathFor, htmlLang, contact, whatsappUrl, type Lang, type Page } from '../i18n';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
  footer?: boolean;
  /** Pages search engines should skip (404): no canonical, robots noindex. */
  noindex?: boolean;
}
const { lang, page, title, description, footer = true, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://www.example.lk');
const canonical = new URL(pathFor(lang, page), site).href;
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <!-- Marks JS as available before first paint, so .reveal content is only hidden when the script will reveal it. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#120B10" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_LK" />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang).nav.skip}</a>
    <Nav lang={lang} page={page} />
    <div class="page-top dark">
      <div class="grid-lines" aria-hidden="true"></div>
      <slot name="hero" />
    </div>
    <main id="main">
      <slot />
    </main>
    {footer && <Footer lang={lang} />}
    <a class="wa-float" href={whatsappUrl} rel="noopener" aria-label={`${t(lang).nav.whatsapp} ${contact.phone}`}>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z" /></svg>
    </a>
    <script>
      // Scroll reveal + cursor spotlights (see src/scripts/motion.ts).
      import '../scripts/motion';
    </script>
  </body>
</html>
