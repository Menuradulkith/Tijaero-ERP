---
import Icon from './Icon.astro';
import { t, pathFor, whatsappUrl, telUrl, type Lang, type Page } from '../i18n';

interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const d = t(lang).nav;
const productPages = d.products.map((p) => p.page);
const inSolutions = productPages.includes(page);
---
<header class="site-header">
  <div class="container">
    <nav class="nav" aria-label="Main" data-open="false">
      <a class="brand" href={pathFor(lang, '')}>
        <span class="brand-mark"><Icon name="logo" size={16} stroke="#fff" width={2.6} /></span>
        <span>Tijaero</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
        <span class="sr-only">{d.menu}</span>
        <Icon name="menu" size={22} />
      </button>
      <div class="nav-links" id="nav-links">
        <div class="dd" data-dd>
          <button class="nav-link dd-btn" type="button" aria-expanded="false" aria-controls="dd-solutions" aria-current={inSolutions ? 'page' : undefined}>
            {d.solutions}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </button>
          <div class="dd-panel" id="dd-solutions">
            {d.products.map((p) => (
              <a class="dd-item" href={pathFor(lang, p.page as Page)} aria-current={page === p.page ? 'page' : undefined}>
                <span class="dd-ico"><Icon name={p.icon} size={18} stroke="#D7A9C9" /></span>
                <span class="dd-txt"><b>{p.name}</b><span>{p.desc}</span></span>
              </a>
            ))}
          </div>
        </div>
        <a class="nav-link" href={pathFor(lang, 'pricing')} aria-current={page === 'pricing' ? 'page' : undefined}>{d.pricing}</a>
        <span class="nav-sep" aria-hidden="true"></span>
        <a class="nav-link nav-contact" href={whatsappUrl} rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z" /></svg>
          {d.whatsapp}
        </a>
        <a class="nav-link nav-contact" href={telUrl}>
          <Icon name="phone" size={15} />
          {d.call}
        </a>
        {page !== 'demo' && <a class="btn btn-white" href={pathFor(lang, 'demo')}>{d.demo}</a>}
      </div>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('.nav');
  const toggle = nav?.querySelector<HTMLButtonElement>('.menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = nav!.dataset.open !== 'true';
    nav!.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
  });
  // Escape closes the phone menu and returns focus to its button.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.dataset.open === 'true') {
      nav.dataset.open = 'false';
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });
  nav?.querySelectorAll('.nav-links a').forEach((a) =>
    a.addEventListener('click', () => { nav.dataset.open = 'false'; toggle?.setAttribute('aria-expanded', 'false'); }),
  );

  // Solutions dropdown: click/keyboard to open, Escape or outside click to close.
  document.querySelectorAll<HTMLElement>('[data-dd]').forEach((dd) => {
    const btn = dd.querySelector<HTMLButtonElement>('.dd-btn')!;
    const set = (open: boolean) => { dd.dataset.open = String(open); btn.setAttribute('aria-expanded', String(open)); };
    btn.addEventListener('click', (e) => { e.stopPropagation(); set(dd.dataset.open !== 'true'); });
    dd.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); btn.focus(); } });
    document.addEventListener('click', (e) => { if (!dd.contains(e.target as Node)) set(false); });
  });
</script>

<style>
  .dd { position: relative; }
  .dd-btn { display: inline-flex; align-items: center; gap: 6px; background: none; border: 0; cursor: pointer; font: inherit; }
  .dd-btn svg { transition: transform .2s; }
  .dd[data-open="true"] .dd-btn svg { transform: rotate(180deg); }
  .dd-panel { display: none; position: absolute; top: calc(100% + 12px); left: -8px; width: 320px; padding: 8px; border-radius: 18px; background: rgba(24,15,21,.96); border: 1px solid rgba(255,255,255,.12); box-shadow: 0 24px 60px rgba(0,0,0,.45); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
  .dd[data-open="true"] .dd-panel { display: block; }
  .dd-item { display: flex; gap: 12px; align-items: flex-start; padding: 12px; border-radius: 12px; text-decoration: none; color: #fff; }
  .dd-item:hover, .dd-item[aria-current="page"] { background: rgba(255,255,255,.07); color: #fff; }
  .dd-ico { flex: none; width: 36px; height: 36px; border-radius: 10px; background: rgba(215,169,201,.14); display: grid; place-items: center; }
  .dd-txt { display: flex; flex-direction: column; gap: 2px; }
  .dd-txt b { font-size: 15px; font-weight: 600; }
  .dd-txt span { font-size: 13px; color: #c9b8c4; }
  .nav-sep { width: 1px; height: 22px; background: rgba(255,255,255,.14); margin: 0 6px; }
  .nav-contact { display: inline-flex; align-items: center; gap: 7px; }
  @media (max-width: 960px) {
    .dd-btn { display: none; }
    .dd-panel { display: block; position: static; width: auto; padding: 0; background: none; border: 0; box-shadow: none; -webkit-backdrop-filter: none; backdrop-filter: none; }
    .nav-sep { display: none; }
  }
</style>
