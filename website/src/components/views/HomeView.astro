---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Screenshot from '../Screenshot.astro';
import { t, pathFor, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.home;
---
<Base lang={lang} page="" title={d.meta.homeTitle} description={d.meta.homeDesc}>
  <section slot="hero" class="hero container">
    <span class="eyebrow glass">
      <span class="flag" aria-hidden="true"><span></span><span></span><span></span></span>
      {h.eyebrow}
    </span>
    <h1 class="hero-h1">
      <span>{h.h1a}</span>
      <span class="grad-text">{h.h1b}</span>
    </h1>
    <p class="hero-sub">{h.sub}</p>
    <div class="hero-ctas">
      <a class="btn btn-primary btn-lg" href={pathFor(lang, 'demo')}>{d.nav.demo}</a>
      <a class="btn btn-ghost btn-lg glass" href={pathFor(lang, 'pricing')}>{h.ctaPricing}</a>
    </div>
    <ul class="trust">
      {h.trust.map((x) => <li><Icon name="check" size={15} stroke="#8FD3CF" width={2.8} />{x}</li>)}
    </ul>
    <div class="hero-shot">
      <div class="hero-glow" aria-hidden="true"></div>
      <Screenshot src="sales-dashboard" alt={h.heroAlt} url="Sales › Dashboard" eager />
    </div>
  </section>

  <!-- Sri Lanka -->
  <section id="srilanka" class="section container stack" style="gap: 48px; padding-bottom: 40px">
    <div class="stack reveal" style="gap: 16px; max-width: 780px">
      <span class="kicker">{h.slKicker}</span>
      <h2 class="h2">{h.slTitle}</h2>
      <p class="lead">{h.slSub}</p>
    </div>
    <div class="bento">
      <div class="card span2 reveal">
        <div class="stack" style="gap: 8px"><h3>{h.b1t}</h3><p style="max-width: 560px">{h.b1d}</p></div>
        <Screenshot src="vat-return" alt={h.vatAlt} url="Finance › VAT Return" aspect={1.9} focus={[1, 0]} />
      </div>

      <div class="card card-dark reveal">
        <div class="stack" style="gap: 8px"><h3>{h.b2t}</h3><p>{h.b2d}</p></div>
        <Screenshot src="payroll" alt={h.payrollAlt} aspect={1.2} zoom={2.3} focus={[0.354, 0.19]} class="tile-shot" />
      </div>

      <div class="card reveal">
        <div class="stack" style="gap: 8px"><h3>{h.b3t}</h3><p>{h.b3d}</p></div>
        <Screenshot src="transfers" alt={h.branchAlt} aspect={1.6} zoom={3} focus={[0.285, 0.15]} class="tile-shot" />
      </div>

      <div class="card reveal">
        <div class="stack" style="gap: 8px"><h3>{h.b4t}</h3><p>{h.b4d}</p></div>
        <div class="mini route">
          <span class="ico"><Icon name="van" size={22} stroke="#714B67" /></span>
          <span class="stack" style="gap: 3px"><b>Route 7 · Matale</b><span class="m">Offline · 23 invoices queued</span></span>
        </div>
      </div>

      <div class="card reveal">
        <div class="stack" style="gap: 8px"><h3>{h.b5t}</h3><p>{h.b5d}</p></div>
        <div class="mini route">
          <span class="ico"><Icon name="phone" size={20} stroke="#714B67" /></span>
          <span class="stack" style="gap: 3px"><b>Call or WhatsApp</b><span class="m">[Mon–Sat, 8.30am–5.30pm]</span></span>
        </div>
      </div>

      <div class="card span2 card-tint reveal">
        <div class="hosting">
          <div class="stack" style="gap: 8px; max-width: 560px"><h3>{h.b6t}</h3><p>{h.b6d}</p></div>
          <div class="pills"><span>Cloud</span><span>On-premise · Docker</span><span>VPN for branches</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product tour: real screens -->
  <section id="tour" class="section container stack" style="gap: 32px; padding-bottom: 0">
    <div class="split reveal">
      <div class="stack" style="gap: 16px; max-width: 680px">
        <span class="kicker">{h.tourKicker}</span>
        <h2 class="h2">{h.tourTitle}</h2>
      </div>
      <p class="lead" style="max-width: 440px; font-size: 17px">{h.tourSub}</p>
    </div>
    <div class="tabs" role="tablist" aria-label={h.tourKicker}>
      {h.tour.map((s, i) => (
        <button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.tab}</button>
      ))}
    </div>
    {h.tour.map((s, i) => (
      <div role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0} class="panel">
        <Screenshot src={s.shot} alt={s.alt} url={s.label} />
      </div>
    ))}
  </section>

  <!-- Modules -->
  <section id="modules" class="section container stack" style="gap: 44px">
    <div class="split reveal">
      <h2 class="h2" style="max-width: 640px">{h.modTitle}</h2>
      <p class="lead" style="max-width: 440px; font-size: 17px">{h.modSub}</p>
    </div>
    <div class="mods">
      {h.mods.map((m) => (
        <div class="mod reveal">
          <span class="mod-ico"><Icon name={m.icon} stroke="#714B67" /></span>
          <div class="stack" style="gap: 5px"><span class="mod-name">{m.name}</span><span class="mod-desc">{m.desc}</span></div>
        </div>
      ))}
    </div>
  </section>

  <!-- Finance -->
  <section id="finance" class="dark">
    <div class="section container stack" style="gap: 56px; position: relative">
      <div class="split reveal">
        <div class="stack" style="gap: 16px; max-width: 720px">
          <span class="kicker">{h.finKicker}</span>
          <h2 class="h2" style="color: #fff">{h.finTitle}</h2>
        </div>
        <p class="lead on-dark" style="max-width: 420px; font-size: 17px">{h.finSub}</p>
      </div>
      <div class="flow">
        <div class="glass flow-card reveal">
          <span class="flow-k">01 · {h.fin1}</span>
          <div class="stack" style="gap: 8px">{['Sales invoice', 'Goods receipt', 'Production order', 'Payroll run'].map((x) => <span class="ev">{x}</span>)}</div>
        </div>
        <div class="glass flow-card reveal">
          <span class="flow-k">02 · {h.fin2}</span>
          <div class="rule"><b>Sales invoice</b><span>Dr · Trade receivables</span><span>Cr · Sales revenue</span><span>Cr · VAT output 18%</span><span class="m">Cost center ← branch</span></div>
        </div>
        <div class="flow-card flow-end reveal">
          <span class="flow-k">03 · {h.fin3}</span>
          <p class="flow-big">{h.fin3d}</p>
        </div>
      </div>
      <ul class="chips">{h.finChips.map((c) => <li class="glass pill">{c}</li>)}</ul>
      <div class="reveal"><Screenshot src="income-statement" alt={h.finAlt} url="Finance › Income Statement" /></div>
    </div>
  </section>

  <!-- AI -->
  <section id="ai" class="section container ai">
    <div class="stack reveal" style="gap: 18px; flex: 1 1 420px; min-width: 0">
      <span class="kicker">Tijaero AI</span>
      <h2 class="h2">{h.aiTitle}</h2>
      <p class="lead" style="font-size: 18px">{h.aiSub}</p>
    </div>
    <div class="chat-wrap reveal">
      <div class="chat-glow" aria-hidden="true"></div>
      <div class="chat">
        <span class="ask-k">{h.aiAskTitle}</span>
        <ul class="asks">{h.aiAsks.map((q) => <li>{q}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- Proof (placeholder) -->
  <section class="container" style="padding-bottom: 120px">
    <figure class="quote reveal">
      <blockquote>{h.quote}</blockquote>
      <figcaption><span class="avatar"></span><span class="stack" style="gap: 2px"><b>{h.quoteBy}</b><span class="m">{h.quoteRole}</span></span></figcaption>
    </figure>
  </section>

  <!-- Rollout -->
  <section class="container stack" style="gap: 44px; padding-bottom: 120px">
    <h2 class="h2 reveal" style="max-width: 760px">{h.roTitle}</h2>
    <ol class="steps">
      {h.steps.map((s) => (
        <li class="card reveal" style="gap: 10px; padding: 28px">
          <span class="when">{s.when}</span>
          <h3 style="font-size: 22px">{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- CTA -->
  <section class="container" style="padding-bottom: 120px">
    <div class="dark cta reveal">
      <div class="grid-lines" aria-hidden="true"></div>
      <h2 class="h2">{h.ctaTitle}</h2>
      <p>{h.ctaSub}</p>
      <div class="hero-ctas">
        <a class="btn btn-white btn-lg" href={pathFor(lang, 'demo')}>{d.nav.demo}</a>
        <a class="btn btn-ghost btn-lg glass" href={pathFor(lang, 'pricing')}>{h.ctaPricing}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Accessible tabs for the product tour (arrow keys move between tabs).
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('#tour [role="tab"]')];
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const n = tabs[(i + d + tabs.length) % tabs.length];
      select(n); n.focus(); e.preventDefault();
    });
  });
</script>

<style>
  .hero-shot { position: relative; width: 100%; margin-top: 56px; }
  .hero-glow { position: absolute; left: 8%; right: 8%; top: 6%; height: 80%; background: radial-gradient(closest-side, rgba(155,107,143,.6), transparent); filter: blur(34px); }
  .hero-shot :global(.shot) { position: relative; border-radius: 16px 16px 0 0; border-color: rgba(255,255,255,.18); box-shadow: 0 -1px 0 rgba(255,255,255,.12), 0 40px 120px rgba(0,0,0,.5); }
  .tile-shot { box-shadow: none; }
  .card-dark :global(.tile-shot) { border-color: rgba(255,255,255,.12); }
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .tabs button { min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--line-2); background: #fff; color: var(--ink-2); font-weight: 600; font-size: 15px; cursor: pointer; }
  .tabs button:hover { border-color: var(--plum); }
  .tabs button[aria-selected="true"] { background: var(--plum); border-color: var(--plum); color: #fff; }
  .panel[hidden] { display: none; }
  .hero { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 26px; padding-top: 96px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 10px; border-radius: 999px; padding: 7px 16px 7px 8px; font-size: 14px; color: #eadde6; }
  .flag { display: inline-flex; width: 26px; height: 18px; border-radius: 4px; overflow: hidden; }
  .flag span:nth-child(1) { width: 5px; background: #00805a; }
  .flag span:nth-child(2) { width: 5px; background: #ff9f1c; }
  .flag span:nth-child(3) { flex: 1; background: #8d153a; }
  .hero-h1 { font-size: clamp(44px, 7vw, 84px); line-height: .98; letter-spacing: -3.2px; font-weight: 800; color: #fff; max-width: 1040px; display: flex; flex-direction: column; }
  .hero-sub { font-size: clamp(17px, 1.6vw, 20px); line-height: 1.6; color: var(--on-dark-muted); max-width: 700px; }
  .hero-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; position: relative; }
  .trust { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; font-size: 14px; color: #bba9b6; }
  .trust li { display: inline-flex; align-items: center; gap: 8px; }

  .m { color: var(--muted-2); }
  .r { text-align: right; }

  .card-dark { background: var(--plum-deep); border-color: var(--plum-deep); color: var(--on-dark); }
  .card-dark h3 { color: #fff; }
  .card-dark p { color: var(--on-dark-muted); }

  .route { display: flex; align-items: center; gap: 14px; }
  .ico { width: 44px; height: 44px; border-radius: 12px; background: var(--plum-tint); display: grid; place-items: center; flex: none; }
  .card-tint { background: linear-gradient(135deg, #f4eef3, #eaf5f4); border-color: #e6dce3; }
  .card-tint p { color: #4f464e; }
  .hosting { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .pills { display: flex; gap: 10px; flex-wrap: wrap; }
  .pills span { background: #fff; border: 1px solid var(--line-2); border-radius: 999px; padding: 10px 16px; font-size: 14px; font-weight: 600; }

  .split { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; }
  .mods { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(270px, 100%), 1fr)); gap: 14px; }
  .mod { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 22px; display: flex; gap: 16px; align-items: flex-start; transition: border-color .2s, transform .2s; }
  .mod:hover { border-color: #d7c3d1; transform: translateY(-2px); }
  .mod-ico { flex: none; width: 44px; height: 44px; border-radius: 12px; background: var(--plum-tint); display: grid; place-items: center; }
  .mod-name { font-family: var(--font-display); font-weight: 600; font-size: 18px; }
  .mod-desc { font-size: 14px; line-height: 1.55; color: var(--muted); }

  .on-dark { color: var(--on-dark-muted); }
  .flow { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 16px; }
  .flow-card { border-radius: 22px; padding: 26px; display: flex; flex-direction: column; gap: 14px; }
  .flow-k { font-size: 12px; color: #bba9b6; text-transform: uppercase; letter-spacing: 1px; }
  .ev { background: rgba(255,255,255,.06); border-radius: 10px; padding: 11px 13px; font-size: 15px; }
  .rule { background: rgba(255,255,255,.06); border-radius: 12px; padding: 16px; font-size: 14px; line-height: 1.8; display: flex; flex-direction: column; }
  .rule b { color: var(--pink-soft); font-weight: 600; } .rule .m { color: #bba9b6; font-size: 13px; }
  .flow-end { background: linear-gradient(160deg, #714b67, #3a2635); border: 1px solid rgba(255,255,255,.18); }
  .flow-end .flow-k { color: #f1ddea; }
  .flow-big { font-family: var(--font-display); font-size: 26px; font-weight: 600; color: #fff; line-height: 1.3; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }

  .ai { display: flex; flex-wrap: wrap; align-items: center; gap: 64px; }
  .chat-wrap { flex: 1 1 480px; min-width: 0; position: relative; }
  .chat-glow { position: absolute; inset: 10% 5%; background: radial-gradient(closest-side, rgba(155,107,143,.28), transparent); filter: blur(24px); }
  .chat { position: relative; background: #fff; border: 1px solid var(--line); border-radius: 26px; padding: 24px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 30px 80px rgba(43,27,39,.12); }
  .ask-k { font-size: 13px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--muted-2); }
  .asks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .asks li { background: var(--plum-tint); border-radius: 14px; padding: 14px 16px; font-size: 16px; line-height: 1.45; }
  .asks li::before { content: "“"; color: var(--plum); font-weight: 700; margin-right: 2px; }
  .asks li::after { content: "”"; color: var(--plum); font-weight: 700; margin-left: 2px; }

  .quote { margin: 0; background: #fff; border: 1px solid var(--line); border-radius: 32px; padding: clamp(32px, 5vw, 64px) clamp(24px, 4vw, 48px); display: flex; flex-direction: column; gap: 28px; }
  .quote blockquote { margin: 0; font-family: var(--font-display); font-size: clamp(24px, 3vw, 36px); line-height: 1.3; font-weight: 500; max-width: 960px; }
  .quote figcaption { display: flex; align-items: center; gap: 14px; }
  .avatar { width: 48px; height: 48px; border-radius: 24px; background: #e8dde5; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 18px; }
  .when { align-self: flex-start; background: var(--plum-tint); color: var(--plum); font-weight: 700; font-size: 13px; border-radius: 999px; padding: 6px 12px; }

  .cta { border-radius: 36px; padding: clamp(56px, 8vw, 96px) 32px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .cta .h2 { position: relative; color: #fff; max-width: 860px; font-size: clamp(34px, 5vw, 62px); }
  .cta p { position: relative; font-size: 19px; line-height: 1.6; color: var(--on-dark-muted); max-width: 600px; }
</style>
