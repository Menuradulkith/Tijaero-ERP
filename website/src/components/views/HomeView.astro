---
// Company home: the three products, who they're for, why us, how we work.
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Screenshot from '../Screenshot.astro';
import { t, pathFor, type Lang, type Page } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.home;
---
<Base lang={lang} page="" title={d.meta.homeTitle} description={d.meta.homeDesc}>
  <section slot="hero" class="hero container">
    <div class="hero-copy">
      <span class="eyebrow glass">
        <span class="flag" aria-hidden="true"><span></span><span></span><span></span></span>
        {h.eyebrow}
      </span>
      <h1 class="hero-h1"><span>{h.h1a}</span> <span class="grad-text">{h.h1b}</span></h1>
      <p class="hero-sub">{h.sub}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary btn-lg" href="#solutions">{h.ctaSolutions}</a>
        <a class="btn btn-ghost btn-lg glass" href={pathFor(lang, 'demo')}>{d.nav.demo}</a>
      </div>
      <ul class="trust">
        {h.trust.map((x) => <li><Icon name="check" size={15} stroke="#8FD3CF" width={2.8} />{x}</li>)}
      </ul>
    </div>
    <div class="hero-shot">
      <div class="hero-glow" aria-hidden="true"></div>
      <Screenshot src="sales-dashboard" alt={h.heroAlt} url="Sales › Dashboard" eager />
    </div>
  </section>

  <!-- solutions -->
  <section id="solutions" class="section container stack" style="gap: 44px">
    <div class="split reveal">
      <div class="stack" style="gap: 14px; max-width: 640px">
        <span class="kicker">{h.solKicker}</span>
        <h2 class="h2">{h.solTitle}</h2>
      </div>
      <p class="lead" style="max-width: 420px; font-size: 17px">{h.solSub}</p>
    </div>
    <div class="sol">
      {h.products.map((p) => (
        <a class="sol-card reveal" href={pathFor(lang, p.page as Page)}>
          <span class="sol-ico"><Icon name={p.icon} size={26} stroke="#fff" /></span>
          <div class="stack" style="gap: 6px">
            <h3>{p.name}</h3>
            <span class="sol-tag">{p.tag}</span>
          </div>
          <ul>{p.points.map((x) => <li><Icon name="check" size={16} stroke="#714B67" width={2.6} />{x}</li>)}</ul>
          <span class="sol-more">{h.learnMore} <Icon name="arrow" size={16} /></span>
        </a>
      ))}
    </div>
  </section>

  <!-- by business type -->
  <section class="container stack" style="gap: 36px; padding-bottom: 112px">
    <div class="stack reveal" style="gap: 14px">
      <span class="kicker">{h.bizKicker}</span>
      <h2 class="h2">{h.bizTitle}</h2>
    </div>
    <div class="biz">
      {h.biz.map((b) => (
        <a class="biz-card reveal" href={pathFor(lang, b.page as Page)}>
          <span class="biz-who">{b.who}</span>
          <span class="biz-rec">{b.rec}</span>
          <p>{b.why}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- why us -->
  <section class="dark why">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container stack" style="gap: 48px; position: relative">
      <div class="stack" style="gap: 14px; max-width: 720px">
        <span class="kicker">{h.whyKicker}</span>
        <h2 class="h2" style="color: #fff">{h.whyTitle}</h2>
      </div>
      <div class="why-grid">
        {h.why.map((w) => (
          <div class="why-card glass reveal">
            <span class="why-ico"><Icon name={w.icon} size={22} stroke="#D7A9C9" /></span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- how we work -->
  <section class="section container stack" style="gap: 40px">
    <h2 class="h2 reveal" style="max-width: 720px">{h.howTitle}</h2>
    <ol class="steps">
      {d.erp.steps.map((s) => (
        <li class="card reveal" style="gap: 10px; padding: 28px">
          <span class="when">{s.when}</span>
          <h3 style="font-size: 22px">{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- services -->
  <section class="container stack" style="gap: 36px; padding-bottom: 112px">
    <div class="stack reveal" style="gap: 14px">
      <span class="kicker">{h.servicesKicker}</span>
      <h2 class="h2">{h.servicesTitle}</h2>
    </div>
    <div class="services">
      {h.services.map((s) => <div class="svc reveal"><h3>{s.t}</h3><p>{s.d}</p></div>)}
    </div>
  </section>

  <!-- CTA -->
  <section class="container" style="padding-bottom: 120px">
    <div class="dark cta reveal">
      <div class="grid-lines" aria-hidden="true"></div>
      <h2 class="h2">{h.ctaTitle}</h2>
      <p>{h.ctaSub}</p>
      <div class="hero-ctas" style="justify-content: center">
        <a class="btn btn-white btn-lg" href={pathFor(lang, 'demo')}>{d.nav.demo}</a>
        <a class="btn btn-ghost btn-lg glass" href={pathFor(lang, 'pricing')}>{d.nav.pricing}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 56px; align-items: center; padding-top: 80px; padding-bottom: 104px; }
  .hero-copy { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .eyebrow { display: inline-flex; align-items: center; gap: 10px; border-radius: 999px; padding: 7px 16px 7px 8px; font-size: 14px; color: #eadde6; }
  .flag { display: inline-flex; width: 26px; height: 18px; border-radius: 4px; overflow: hidden; }
  .flag span:nth-child(1) { width: 5px; background: #00805a; }
  .flag span:nth-child(2) { width: 5px; background: #ff9f1c; }
  .flag span:nth-child(3) { flex: 1; background: #8d153a; }
  .hero-h1 { font-size: clamp(40px, 5.4vw, 70px); line-height: 1; letter-spacing: -2.6px; font-weight: 800; color: #fff; }
  .hero-sub { font-size: clamp(17px, 1.5vw, 19px); line-height: 1.6; color: var(--on-dark-muted); max-width: 580px; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; position: relative; }
  .trust { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 14px; color: #bba9b6; }
  .trust li { display: inline-flex; align-items: center; gap: 8px; }
  .hero-shot { position: relative; }
  .hero-glow { position: absolute; inset: 6% 6%; background: radial-gradient(closest-side, rgba(155,107,143,.6), transparent); filter: blur(34px); }
  .hero-shot :global(.shot) { position: relative; border-color: rgba(255,255,255,.18); box-shadow: 0 40px 120px rgba(0,0,0,.5); }
  @media (max-width: 1000px) { .hero { grid-template-columns: minmax(0, 1fr); padding-top: 48px; } }

  .split { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; }
  .sol { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 18px; }
  .sol-card { background: #fff; border: 1px solid var(--line); border-radius: 26px; padding: 30px; display: flex; flex-direction: column; gap: 20px; text-decoration: none; color: var(--ink); transition: transform var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard); }
  .sol-card:hover { color: var(--ink); transform: translateY(var(--lift)); border-color: #d7c3d1; box-shadow: 0 24px 60px rgba(43,27,39,.1); }
  .sol-ico { width: 52px; height: 52px; border-radius: 16px; background: linear-gradient(135deg, var(--plum-light), var(--plum)); display: grid; place-items: center; }
  .sol-card h3 { font-size: 26px; }
  .sol-tag { font-size: 15px; color: var(--muted); }
  .sol-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .sol-card li { display: flex; gap: 10px; line-height: 1.45; }
  .sol-card li :global(svg) { flex: none; margin-top: 2px; }
  .sol-more { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--plum); }

  .biz { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 14px; }
  .biz-card { border: 1px solid var(--line); background: #fff; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 8px; text-decoration: none; color: var(--ink); transition: border-color .2s; }
  .biz-card:hover { border-color: var(--plum); color: var(--ink); }
  .biz-who { font-family: var(--font-display); font-weight: 700; font-size: 19px; }
  .biz-rec { align-self: flex-start; background: var(--plum-tint); color: var(--plum); font-weight: 600; font-size: 13px; border-radius: 999px; padding: 5px 12px; }
  .biz-card p { font-size: 15px; line-height: 1.55; color: var(--muted); }

  .why { padding: 112px 0; }
  .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 16px; }
  .why-card { border-radius: 22px; padding: 26px; display: flex; flex-direction: column; gap: 12px; }
  .why-ico { width: 44px; height: 44px; border-radius: 12px; background: rgba(215,169,201,.14); display: grid; place-items: center; }
  .why-card h3 { font-size: 20px; color: #fff; }
  .why-card p { font-size: 15px; line-height: 1.6; color: var(--on-dark-muted); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 18px; }
  .when { align-self: flex-start; background: var(--plum-tint); color: var(--plum); font-weight: 700; font-size: 13px; border-radius: 999px; padding: 6px 12px; }

  .services { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 14px; }
  .svc { border-top: 2px solid var(--plum); padding-top: 18px; display: flex; flex-direction: column; gap: 8px; }
  .svc h3 { font-size: 19px; }
  .svc p { font-size: 15px; line-height: 1.6; color: var(--muted); }

  .cta { border-radius: 36px; padding: clamp(56px, 8vw, 96px) 32px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .cta .h2 { position: relative; color: #fff; max-width: 860px; }
  .cta p { position: relative; font-size: 19px; line-height: 1.6; color: var(--on-dark-muted); max-width: 600px; }
</style>
