---
// Shared layout for the POS and Distributor Lanka product pages.
// Content comes from en.ts (`pos` or `dist`); screenshots are real or a labelled placeholder.
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Screenshot from '../Screenshot.astro';
import ShotPlaceholder from '../ShotPlaceholder.astro';
import { t, pathFor, type Lang } from '../../i18n';

interface Props { lang: Lang; product: 'pos' | 'dist'; shot?: string }
const { lang, product, shot } = Astro.props;
const d = t(lang);
const p = d[product] as typeof d.dist & typeof d.pos & Record<string, any>;
const page = product === 'pos' ? 'pos' : 'distribution';
const title = product === 'pos' ? d.meta.posTitle : d.meta.distTitle;
const desc = product === 'pos' ? d.meta.posDesc : d.meta.distDesc;
const heroShot = shot ?? p.heroShot;
const pricingHref = pathFor(lang, 'pricing', product === 'pos' ? '?product=pos' : '?product=distributor');
const demoHref = pathFor(lang, 'demo', product === 'pos' ? '?product=pos' : '?product=distributor');
---
<Base lang={lang} page={page} title={title} description={desc}>
  <section slot="hero" class="p-hero container">
    <div class="p-copy">
      <span class="eyebrow glass">{p.eyebrow}</span>
      <h1><span>{p.h1a}</span> <span class="grad-text">{p.h1b}</span></h1>
      <p class="p-sub">{p.sub}</p>
      <div class="p-ctas">
        <a class="btn btn-primary btn-lg" href={demoHref}>{d.nav.demo}</a>
        <a class="btn btn-ghost btn-lg glass" href="#modules">{p.modKicker}</a>
      </div>
      <dl class="stats">
        {p.stats.map((s: { v: string; l: string }) => <div><dt>{s.v}</dt><dd>{s.l}</dd></div>)}
      </dl>
    </div>
    <div class="p-shot">
      <div class="glow" aria-hidden="true"></div>
      {heroShot ? <Screenshot src={heroShot} alt={p.shotNote} app={p.shotLabel.split(' · ')[0]} url={p.shotLabel.split(' · ')[1]} eager /> : <ShotPlaceholder label={p.shotLabel} note={p.shotNote} dark />}
    </div>
  </section>

  {p.draftNote && <div class="container" style="padding-top: 32px"><p class="draft-note">{p.draftNote}</p></div>}

  <!-- highlight -->
  <section class:list={['section', 'container', 'feat', { 'feat-split': p.featShot }]}>
    <div class="stack reveal" style="gap: 16px; max-width: 640px">
      <span class="kicker">{p.featKicker}</span>
      <h2 class="h2">{p.featTitle}</h2>
      <p class="lead">{p.featBody}</p>
      {p.formula && <p class="formula tnum"><code>{p.formula}</code></p>}
    </div>
    {p.featShot && <div class="reveal"><Screenshot src={p.featShot.src} alt={p.featShot.alt} app={p.shotLabel.split(' · ')[0]} url={p.featShot.url} /></div>}
  </section>

  <!-- modules -->
  <section id="modules" class="container stack" style="gap: 40px; padding-bottom: 112px">
    <div class="stack reveal" style="gap: 14px; max-width: 720px">
      <span class="kicker">{p.modKicker}</span>
      <h2 class="h2">{p.modTitle}</h2>
    </div>
    <div class="mods">
      {p.mods.map((m: { icon: string; name: string; desc: string }) => (
        <div class="mod reveal">
          <span class="mod-ico"><Icon name={m.icon} stroke="#714B67" /></span>
          <div class="stack" style="gap: 6px"><h3>{m.name}</h3><p>{m.desc}</p></div>
        </div>
      ))}
    </div>
  </section>

  {p.gallery && (
    <section class="container stack" style="gap: 32px; padding-bottom: 112px">
      <h2 class="h2 reveal">{p.galleryTitle}</h2>
      <div class="gallery">
        {p.gallery.map((g: { src: string; url: string; t: string; alt: string }) => (
          <figure class="reveal">
            <Screenshot src={g.src} alt={g.alt} app={p.shotLabel.split(' · ')[0]} url={g.url} />
            <figcaption>{g.t}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {p.deployTitle && (
    <section class="dark deploy">
      <div class="grid-lines" aria-hidden="true"></div>
      <div class="container deploy-in">
        <div class="stack" style="gap: 14px; max-width: 620px">
          <h2 class="h2" style="color: #fff">{p.deployTitle}</h2>
          <p class="lead" style="color: var(--on-dark-muted)">{p.deployBody}</p>
        </div>
        <ul class="pills-dark">{p.deployPoints.map((x: string) => <li class="glass">{x}</li>)}</ul>
      </div>
    </section>
  )}

  {p.plans && (
    <section id="packages" class="section container stack" style="gap: 36px">
      <div class="stack reveal" style="gap: 12px; max-width: 720px">
        <h2 class="h2">{p.plansTitle}</h2>
        <p class="lead">{p.plansSub}</p>
      </div>
      <div class="pkgs">
        {p.plans.map((x: { name: string; price: string; per: string; tag: string; featured?: boolean; features: string[] }) => (
          <div class:list={['card', 'pkg', 'reveal', { featured: x.featured }]}>
            {x.featured && <span class="badge">{d.pricing.popular}</span>}
            <h3>{x.name}</h3>
            <p class="pkg-tag">{x.tag}</p>
            <p class="pkg-price tnum"><b>{x.price}</b> {x.per && <span>{x.per}</span>}</p>
            <ul>{x.features.map((f) => <li><Icon name="check" size={16} stroke="#714B67" width={2.6} />{f}</li>)}</ul>
            <a class:list={['btn', x.featured ? 'btn-primary' : 'btn-outline']} href={demoHref}>{x.price === 'Custom' ? d.pricing.othersCta : d.nav.demo}</a>
          </div>
        ))}
      </div>
      <p class="pkg-note">{p.plansNote}</p>
    </section>
  )}

  <!-- before you switch -->
  <section class="section container stack" style="gap: 32px">
    <div class="stack reveal" style="gap: 10px">
      <h2 class="h2">{p.prepTitle}</h2>
      <p class="lead">{p.prepSub}</p>
    </div>
    <ol class="prep">
      {p.prep.map((s: { t: string; d: string }, i: number) => (
        <li class="card reveal"><span class="num">{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>
      ))}
    </ol>
  </section>

  <!-- FAQ -->
  <section class="container faq">
    <h2 class="h2" style="font-size: clamp(30px, 4vw, 44px); margin-bottom: 16px">{p.faqTitle}</h2>
    {p.faq.map((q: { q: string; a: string }) => (
      <details><summary>{q.q}<span aria-hidden="true">+</span></summary><p>{q.a}</p></details>
    ))}
  </section>

  <!-- CTA -->
  <section class="container" style="padding-bottom: 120px">
    <div class="dark cta reveal">
      <div class="grid-lines" aria-hidden="true"></div>
      <h2 class="h2">{p.ctaTitle}</h2>
      <p>{p.ctaSub}</p>
      <div class="p-ctas" style="justify-content: center">
        <a class="btn btn-white btn-lg" href={demoHref}>{d.nav.demo}</a>
        <a class="btn btn-ghost btn-lg glass" href={pricingHref}>{d.nav.pricing}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .p-hero { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 56px; align-items: center; padding-top: 72px; padding-bottom: 96px; }
  .p-copy { display: flex; flex-direction: column; gap: 22px; align-items: flex-start; }
  .eyebrow { display: inline-flex; border-radius: 999px; padding: 7px 14px; font-size: 13px; color: #eadde6; }
  .p-hero h1 { font-size: clamp(38px, 5vw, 64px); line-height: 1.02; letter-spacing: -2.2px; font-weight: 800; color: #fff; }
  .p-sub { font-size: 18px; line-height: 1.6; color: var(--on-dark-muted); max-width: 560px; }
  .p-ctas { display: flex; flex-wrap: wrap; gap: 12px; position: relative; }
  .stats { display: flex; flex-wrap: wrap; gap: 32px; margin: 8px 0 0; }
  .stats dt { font-family: var(--font-display); font-size: 26px; font-weight: 700; color: #fff; }
  .stats dd { margin: 2px 0 0; font-size: 13px; color: #bba9b6; max-width: 200px; }
  .p-shot { position: relative; }
  .glow { position: absolute; inset: 8% 6%; background: radial-gradient(closest-side, rgba(155,107,143,.55), transparent); filter: blur(32px); }
  .p-shot :global(.shot), .p-shot :global(.ph) { position: relative; }
  @media (max-width: 960px) { .p-hero { grid-template-columns: minmax(0, 1fr); padding-top: 48px; } }

  .feat { padding-bottom: 72px; }
  .feat-split { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 56px; align-items: center; }
  @media (max-width: 960px) { .feat-split { grid-template-columns: minmax(0, 1fr); } }
  .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: 24px; }
  .gallery figure { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .gallery figcaption { font-size: 17px; font-weight: 600; color: var(--ink); }
  .formula { margin: 8px 0 0; }
  .formula code { display: inline-block; font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace; font-size: 15px; background: var(--plum-tint); color: var(--plum-deep); border: 1px solid #e6dce3; border-radius: 12px; padding: 12px 16px; line-height: 1.5; white-space: normal; }

  .mods { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px; }
  .mod { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 24px; display: flex; gap: 16px; align-items: flex-start; }
  .mod-ico { flex: none; width: 44px; height: 44px; border-radius: 12px; background: var(--plum-tint); display: grid; place-items: center; }
  .mod h3 { font-size: 18px; }
  .mod p { font-size: 15px; line-height: 1.55; color: var(--muted); }

  .deploy { padding: 88px 0; }
  .deploy-in { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px; }
  .pills-dark { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .pills-dark li { border-radius: 999px; padding: 12px 18px; font-size: 15px; color: #fff; }

  .pkgs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 16px; align-items: stretch; }
  .pkg { gap: 12px; padding: 28px; }
  .pkg.featured { border-color: var(--plum); box-shadow: 0 0 0 1px var(--plum), 0 24px 60px rgba(113,75,103,.14); }
  .badge { align-self: flex-start; background: var(--plum); color: #fff; font-size: 12px; font-weight: 700; border-radius: 999px; padding: 4px 10px; }
  .pkg h3 { font-size: 22px; }
  .pkg-tag { font-size: 14px; color: var(--muted); min-height: 40px; }
  .pkg-price b { font-family: var(--font-display); font-size: 30px; font-weight: 800; color: var(--ink); }
  .pkg-price span { font-size: 15px; color: var(--muted); }
  .pkg ul { list-style: none; margin: 4px 0 8px; padding: 0; display: flex; flex-direction: column; gap: 9px; flex: 1; font-size: 15px; color: var(--ink-2); }
  .pkg li { display: flex; gap: 9px; align-items: flex-start; line-height: 1.45; }
  .pkg li :global(svg) { flex: none; margin-top: 3px; }
  .pkg-note { font-size: 14px; color: var(--muted); }
  .prep { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 18px; }
  .prep .card { gap: 10px; padding: 28px; }
  .num { width: 34px; height: 34px; border-radius: 50%; background: var(--plum); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 15px; }
  .prep h3 { font-size: 20px; }

  .faq { max-width: 868px; display: flex; flex-direction: column; gap: 12px; padding-bottom: 112px; }
  details { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 4px 24px; }
  summary { list-style: none; font-size: 17px; font-weight: 600; cursor: pointer; padding: 18px 0; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary span { color: var(--plum); font-size: 22px; line-height: 1; transition: transform var(--dur-base) var(--ease-standard); }
  details[open] summary span { transform: rotate(45deg); }
  details p { margin-bottom: 20px; font-size: 16px; line-height: 1.65; color: var(--muted); }

  .cta { border-radius: 36px; padding: clamp(56px, 8vw, 96px) 32px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .cta .h2 { position: relative; color: #fff; max-width: 820px; }
  .cta p { position: relative; font-size: 18px; line-height: 1.6; color: var(--on-dark-muted); max-width: 600px; }
</style>
