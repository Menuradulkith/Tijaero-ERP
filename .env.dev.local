# Global Environment Variables for ERP System - SERVER/PRODUCTION
# Server IP: 127.0.0.1

# Project Configuration
PROJECT_NAME=Tijaero ERP System
VERSION=1.0.0
API_V1_STR=/api/v1
GATEWAY_IP=127.0.0.1

# Database Configuration
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_IN_PRODUCTION
POSTGRES_DB=erp_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Backend Configuration
BACKEND_PORT=8000
SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_MIN_32_CHARS_FOR_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS=["http://127.0.0.1:3000","http://127.0.0.1:8000","http://127.0.0.1:80","https://yourdomain.com"]

# Frontend Configuration
FRONTEND_PORT=3000
#VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_API_URL=http://127.0.0.1/api/v1

# Adminer Configuration
ADMINER_PORT=8080
ADMINER_DEFAULT_SERVER=postgres
ADMINER_DESIGN=nette

# pgAdmin Configuration
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
