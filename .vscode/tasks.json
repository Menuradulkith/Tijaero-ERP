{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Git Status",
			"type": "shell",
			"command": "git status",
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Continue Rebase",
			"type": "shell",
			"command": "git add .vscode/tasks.json && GIT_EDITOR=true git rebase --continue",
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Check Markers",
			"type": "shell",
			"command": "python3 -c \"import re; f = open('frontend/src/app/pages/DashboardPage.tsx').read(); res = re.findall(r'<<<<<<< HEAD.*?=======\\n(.*?)\\n>>>>>>> [0-9a-f]+.*?\\n', f, re.DOTALL); print(len(res))\"",
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Read Mergers",
			"type": "shell",
			"command": "grep -n -C 5 \"<<<<<<< HEAD\" frontend/src/app/pages/DashboardPage.tsx",
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Read Dashboard",
			"type": "shell",
			"command": "sed -n '345,700p' frontend/src/app/pages/DashboardPage.tsx",
			"isBackground": false,
			"group": "test"
		},
