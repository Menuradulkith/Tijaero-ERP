{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && ..\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --port 8020"],
      "port": 8020,
      "autoPort": false,
      "url": "http://localhost:8020"
    },
    {
      "name": "backend-8021",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && ..\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --port 8021"],
      "port": 8021,
      "autoPort": false,
      "url": "http://localhost:8021"
    },
    {
      "name": "frontend-3001",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_API_URL=http://localhost:8021/api/v1&& npm run dev --prefix frontend -- --port 3001 --strictPort"],
      "port": 3001,
      "autoPort": false
    }
  ]
}
